# Copy this file to .env.local (same folder as package.json) and fill in your keys.
# .env.local is git-ignored. Restart `npm run dev` after editing it.
# With no keys at all, Lucid runs in DEMO MODE with canned data.

# ── LLM: any OpenAI-compatible provider ────────────────────────────────
# Groq (free, very fast, no card): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# OpenRouter (free models end in :free): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (fully offline, runs on your laptop): https://ollama.com
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ── Web search ─────────────────────────────────────────────────────────
# Tavily (free 1,000 credits/month, no card): https://app.tavily.com
TAVILY_API_KEY=
